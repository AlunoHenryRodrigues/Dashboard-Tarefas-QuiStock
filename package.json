{
  "name": "quistock-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "deploy:pages": "node scripts/check-workbook.mjs && npm run build && node scripts/publish-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src/data.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
